    "eslint": "9.39.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "sass": "1.107.1",
    "stylelint": "17.16.0",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-declaration-strict-value": "1.12.1",
