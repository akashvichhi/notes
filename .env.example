# Read by docker-compose.yml, for itself and for the API. Copy to .env to run the app with
# Docker on your machine. On a server, copy .env.production instead.

# Postgres reads this only when it creates the database on the first start. It goes into
# a URL, so use letters and digits only (for example the output of `openssl rand -hex 32`).
POSTGRES_PASSWORD=secret

# The site's origin: writes with the session cookie are accepted only from it.
# Comma-separated when there are several: the app answers on both localhost and
# 127.0.0.1, and a browser treats them as different sites.
APP_ORIGIN=http://localhost:8000,http://127.0.0.1:8000

# ":80" serves plain HTTP; on a server it is the domain, so Caddy gets an HTTPS certificate.
SITE_ADDRESS=:80
HTTP_PORT=8000
HTTPS_PORT=8443

# The API (app/core/config.py), as in production. DATABASE_URL and ALLOWED_ORIGINS are
# built in docker-compose.yml from POSTGRES_PASSWORD and APP_ORIGIN above. Browsers keep
# Secure cookies on localhost too, so the session cookie stays Secure here.
APP_ENV=production
CORS_ORIGINS=
SESSION_COOKIE_NAME=notes_session
SESSION_LIFETIME_DAYS=30
SESSION_COOKIE_SECURE=true
WEB_DIST_DIR=/app/web/dist
LOG_LEVEL=INFO
