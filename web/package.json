{
  "name": "notes-app",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "clean": "node -e \"import('node:fs').then(fs => { fs.rmSync('../api/public/assets', { recursive: true, force: true }); fs.rmSync('../api/public/index.html', { force: true }); })\"",
    "build": "tsc -b && vite build",
    "build:prod": "npm run clean && npm run build",
    "deploy": "cd .. && git add . && git commit -m \"Prod: release\" && git push origin master",
    "release": "npm run build:prod && npm run deploy",
    "lint": "eslint . --fix",
    "tsc": "tsc -b --noEmit",
    "check": "npm run lint && npm run lint:style && npm run tsc && npm run test",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "lint:style": "stylelint \"src/**/*.{css,scss}\" --fix",
    "test": "vitest run"
  },
  "dependencies": {
    "@mantine/code-highlight": "9.7.4",
    "@mantine/core": "9.7.4",
    "@mantine/form": "9.7.4",
    "@mantine/hooks": "9.7.4",
    "@mantine/modals": "9.7.4",
    "@mantine/notifications": "9.7.4",
    "@mantine/spotlight": "9.7.4",
    "@mantine/tiptap": "9.7.4",
    "@tabler/icons-react": "3.50.0",
    "@tanstack/react-query": "5.105.0",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-os": "2.4.0",
    "@tauri-apps/plugin-sql": "2.6.0",
    "@tiptap/extension-character-count": "3.32.2",
    "@tiptap/extension-code-block-lowlight": "3.32.2",
    "@tiptap/extension-color": "3.32.2",
    "@tiptap/extension-details": "3.32.2",
    "@tiptap/extension-highlight": "3.32.2",
    "@tiptap/extension-image": "3.32.2",
    "@tiptap/extension-invisible-characters": "3.32.2",
    "@tiptap/extension-link": "3.32.2",
    "@tiptap/extension-placeholder": "3.32.2",
    "@tiptap/extension-subscript": "3.32.2",
    "@tiptap/extension-superscript": "3.32.2",
    "@tiptap/extension-table": "3.32.2",
