# Every env file stays out, web/.env.production included: the image serves the web app
# from the API's own origin, so the build must not point it at another server
# (web/src/config/env.ts). Compose passes the API its settings at run time.
.git
**/node_modules
**/.env
**/.env.*
**/__pycache__
**/.venv
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.coverage
**/htmlcov
api/tests
api-laravel
web/coverage
web/dist
assets
docs
mockup
