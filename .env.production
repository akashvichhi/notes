# The server's settings. On the server: `cp .env.production .env`, then set
# POSTGRES_PASSWORD. docker-compose.yml reads that .env, for itself and for the API.

# Postgres reads this only when it creates the database on the first start. It goes into
# a URL, so use letters and digits only, e.g. the output of `openssl rand -hex 32`.
# Left empty, `docker compose` refuses to start.
POSTGRES_PASSWORD=

# The site's origin: writes with the session cookie are accepted only from it.
APP_ORIGIN=https://my-notes.app

# The hosting provider's proxy answers for the domain and handles HTTPS, then forwards
# plain HTTP to port 80 of the VPS. So Caddy serves HTTP only and asks for no certificate.
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=8443

# The API (app/core/config.py). DATABASE_URL and ALLOWED_ORIGINS are built in
# docker-compose.yml from POSTGRES_PASSWORD and APP_ORIGIN above.
APP_ENV=production
CORS_ORIGINS=
SESSION_COOKIE_NAME=notes_session
SESSION_LIFETIME_DAYS=30
SESSION_COOKIE_SECURE=true
WEB_DIST_DIR=/app/web/dist
LOG_LEVEL=INFO

# Nightly database backup (decision 11): only the newest is kept. Leave
# BACKUP_REMOTE_TYPE empty to turn backups off. The account must not use two-factor
# login, since the nightly run cannot type a code. Plain password; it is never logged.
# BACKUP_REMOTE_TYPE is rclone's name for the storage service (https://rclone.org/overview/).
BACKUP_REMOTE_TYPE=
BACKUP_REMOTE_USER=
BACKUP_REMOTE_PASSWORD=
BACKUP_REMOTE_FOLDER=notes-backups
