# Read by docker-compose.yml. Copy to .env and change the values on the server.

# Postgres reads this only when it creates the database on the first start, so set a
# strong password before then. It goes into a URL, so use letters and digits only
# (for example the output of `openssl rand -hex 32`).
POSTGRES_PASSWORD=secret

# The site's origin: writes with the session cookie are accepted only from it.
# Locally the default below; on the server "https://" and the domain.
APP_ORIGIN=http://127.0.0.1:8000

# Locally ":80". On the server, the domain (for example my-notes.app), so Caddy
# gets an HTTPS certificate; then set HTTP_PORT=80 and HTTPS_PORT=443.
SITE_ADDRESS=:80
HTTP_PORT=8000
HTTPS_PORT=8443
