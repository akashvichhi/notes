# Every env file stays out: the image serves the web app from the API's own origin, so a
# local web/.env must not point the build at another server (web/src/config/env.ts).
# Compose passes the API its settings at run time.
.git
**/node_modules
**/.env
**/.env.*
**/__pycache__
**/.venv
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.coverage
**/htmlcov
api/tests
api-laravel
web/coverage
web/dist
assets
docs
