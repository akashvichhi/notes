# Copy to api/.env. Read only by app/core/config.py.

# local | test | production. Anything but production turns on CORS for the
# Vite dev server and allows the session cookie over plain HTTP.
APP_ENV=local

# SQLAlchemy URL of the Postgres database (psycopg 3 driver).
DATABASE_URL=postgresql+psycopg://notes:secret@127.0.0.1:5432/notes

# Origins allowed to send POST/PATCH/PUT/DELETE with the session cookie,
# comma-separated. On the server: the site's own origin, e.g. https://notes.example.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Origins that get CORS headers. Local development only; leave empty in production,
# where the web app is served from the API's own origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# The browser session.
SESSION_COOKIE_NAME=notes_session
SESSION_LIFETIME_DAYS=30
# true everywhere except local development over plain HTTP.
SESSION_COOKIE_SECURE=false

# The web app's build, served for every non-API path.
WEB_DIST_DIR=../web/dist

LOG_LEVEL=INFO

# The public demo account, reset every night to the sample notes in
# api/app/content/data/demo_content.toml (decision 14). Leave DEMO_EMAIL empty to turn
# the reset off; when it is set, DEMO_PASSWORD and DEMO_NAME must be set too.
DEMO_EMAIL=
DEMO_PASSWORD=
DEMO_NAME=
